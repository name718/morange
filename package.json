{
  "name": "morange-monorepo",
  "private": true,
  "description": "Morange (沐橙) suite of WeChat Mini Programs",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @morange/convert dev:weapp",
    "dev:box": "pnpm --filter @morange/box dev:weapp",
    "dev:convert": "pnpm --filter @morange/convert dev:weapp",
    "lint": "pnpm -r --if-present lint",
    "type-check": "pnpm -r --if-present type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,scss}\""
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.24.1",
    "@tarojs/cli": "^4.2.0",
    "@tarojs/plugin-framework-react": "^4.2.0",
    "@tarojs/plugin-platform-weapp": "^4.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-loader": "^8.2.1",
    "babel-preset-taro": "^4.2.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "less": "^4.2.0",
    "prettier": "^3.0.0",
    "react-refresh": "^0.14.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@tarojs/components": "^4.2.0",
    "@tarojs/helper": "^4.2.0",
    "@tarojs/react": "^4.2.0",
    "@tarojs/runtime": "^4.2.0",
    "@tarojs/shared": "^4.2.0",
    "@tarojs/taro": "^4.2.0",
    "@tarojs/webpack5-runner": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
